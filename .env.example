# bt eval reuses your saved bt login. No API key is needed in this file.
# Set the organization explicitly if your login can access multiple organizations.
BRAINTRUST_ORG_NAME="your-org-name"
BRAINTRUST_PROJECT=braintrust-skills

# Defaults use your organization's Braintrust Gateway provider configuration.
EVAL_MODEL=gpt-5-mini
EVAL_JUDGE_MODEL=gpt-5-mini
EVAL_TRIALS=1
EVAL_CONCURRENCY=2

# Optional: call OpenAI directly instead of the Gateway.
# OPENAI_API_KEY=...
# Optional: a different OpenAI-compatible endpoint (choose the matching API key).
# EVAL_BASE_URL=https://gateway.braintrust.dev

# Use EVAL_WITH_SKILL=false for a baseline without skill text or references.
# EVAL_CASES=fresh-typescript,already-working
# Optional: compare one suite against a specific previous experiment from that suite.
# EVAL_BASE_EXPERIMENT=mcp-workflow-baseline
